{
  "name": "erp_project",
  "version": "1.0.0",
  "description": "A full-stack Enterprise Resource Planning system built with Next.js, TypeScript, Tailwind CSS, and MariaDB via mysql2.",
  "license": "ISC",
  "author": "",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:changed": "node tests/lint-changed.mjs",
    "test": "tsx --test \"tests/unit/*.test.ts\"",
    "test:db": "tsx --env-file-if-exists=.env --test \"tests/db/*.test.ts\"",
    "test:all": "npm test && npm run test:db",
    "test:smoke": "node --env-file=.env tests/postman/smoke.mjs",
    "test:load": "node --env-file=.env tests/load.mjs",
    "test:checks": "tsx tests/run-checks.ts",
    "db:test": "tsx scripts/test-connection.js",
    "db:seed": "tsx scripts/seed-permissions.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "chalk": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.4.2",
    "lucide-react": "^1.18.0",
    "mysql2": "^3.22.5",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "prisma": "^7.8.0",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uid": "^2.0.2",
    "unpdf": "^1.8.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  }
}
