model master_skus {
  id                                             Int                       @id @default(autoincrement())
  sku_code                                       String                    @unique(map: "sku_code") @db.VarChar(50)
  name                                           String                    @db.VarChar(200)
  /// Free text, and the grouping key for variant families alongside
  /// base_sku_sno. Kept for display; `brand_id` is the access boundary.
  brand                                          String?                   @db.VarChar(100)
  /// The other half of the variant-family grouping key: SKUs sharing one
  /// (brand, base_sku_sno) are the same product in different pack sizes. A
  /// value every family member SHARES — NOT a pointer to a base row, and never
  /// written by app code (it arrives from upstream ETL).
  base_sku_sno                                   Int?
  /// Which member of that family owns the RM formulation. RM is family-scoped
  /// (identical across pack sizes) and PM is SKU-scoped, so Recipe Master locks
  /// RM on a non-base variant and only lets it change from the base — fanning
  /// the change out to every sibling. Picked by a human in SKU Master ->
  /// Variants; see prisma/add_sku_is_base_sku.sql and
  /// lib/masters/variant-rm-lock.ts. At most one per family, enforced by the
  /// clear-then-set transaction in skus.clearBaseForFamily/setBaseSku, NOT by
  /// an index.
  is_base_sku                                    Boolean                   @default(false) @db.TinyInt
  /// NOTE: this model is still missing sku_type, subcategory, filling,
  /// filling_uom, mrp, gst, active_bom_id, updated_by and updated_on, all of
  /// which are real columns SKU_COLUMNS selects (lib/queries/skus.ts). Prisma
  /// is schema-only here so nothing breaks; that drift is its own cleanup.
  /// master_brand.id — the ACCESS BOUNDARY key. NULL = unattributed, which means
  /// visible to every brand-scoped user. See prisma/add_master_brand.sql.
  brand_id                                       Int?
  category                                       String?                   @db.VarChar(100)
  status                                         master_skus_status?       @default(active)
  created_at                                     DateTime?                 @default(now()) @db.Timestamp(0)
  created_by                                     Int?
  details_sku                                    details_sku?
  master_bom                                     master_bom[]
  master_cost_ext_fixed                          master_cost_ext_fixed[]
  master_cost_int_dynamic                        master_cost_int_dynamic[]
  users                                          users?                    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "master_skus_ibfk_1")
  sku_variants_sku_variants_parent_sku_idToskus  sku_variants[]            @relation("sku_variants_parent_sku_idToskus")
  sku_variants_sku_variants_variant_sku_idToskus sku_variants[]            @relation("sku_variants_variant_sku_idToskus")
  master_brand                                   master_brand?             @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sku_brand")

  @@index([created_by], map: "created_by")
  @@index([brand_id], map: "idx_sku_brand_id")
}

/// Our brands, canonicalised. Exists because brand became an ACCESS BOUNDARY and
/// master_skus.brand is free text — the dev survey found 'FIEN' (a transposed
/// 'Fein') on 28 SKUs, which a `brand = 'Fein'` predicate would have silently
/// excluded. `brand_key` is the normalised comparison key and mirrors brandKey()
/// in lib/constants.ts; if the two diverge, the boundary and the display value
/// disagree.
