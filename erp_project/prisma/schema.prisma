model details_vendor {
  id                   Int                    @id @default(autoincrement())
  vendor_id            Int
  location             String?                @db.VarChar(200)
  status               details_vendor_status? @default(active)
  zone                 String?                @db.VarChar(50)
  registered_name      String?                @db.VarChar(100)
  gst_number           String?                @db.VarChar(20)
  bank_name            String?                @db.VarChar(255)
  ifsc_number          String?                @db.VarChar(11)
  account_number       String?                @db.VarChar(50)
  gst_certificate_key  String?                @db.Text
  cancelled_cheque_key String?                @db.Text
  pan_card_key         String?                @db.Text
  misc_document_key    String?                @db.Text
  master_vendors       master_vendors         @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "details_vendor_ibfk_1")

  @@index([vendor_id], map: "vendor_id")
}

/// Addresses SES reported as a permanent bounce or a complaint. Written by the
/// SNS webhook (app/api/v1/webhooks/ses/route.ts), read by resolveRecipients()
/// in lib/mailer.ts to drop them from both the To and CC list of every send.
///
/// Deliberately NOT a flag on entity_emails: resolveRecipients also merges a
/// `primaryEmail` from details_mfg.email, which has no entity_emails row and so
/// could not be suppressed by a per-row column — and it is the address most
/// likely to be stale. See prisma/add_email_suppressions.sql.
model email_suppressions {
  id             Int                        @id @default(autoincrement())
  /// Stored lowercased by the webhook, so the UNIQUE index gives idempotency
  /// under SNS's at-least-once delivery.
  email          String                     @unique(map: "uq_email_suppression") @db.VarChar(255)
  reason         email_suppressions_reason
  /// SES's own sub-classification — bounceSubType, or complaintFeedbackType.
  /// Kept verbatim so the admin screen can explain why, not just that.
  detail         String?                    @db.VarChar(500)
  ses_message_id String?                    @db.VarChar(255)
  suppressed_at  DateTime                   @default(now()) @db.Timestamp(0)
}

enum email_suppressions_reason {
  bounce
  complaint
  manual
}

model entity_emails {
  id          Int                       @id @default(autoincrement())
  entity_type entity_emails_entity_type
  entity_code String                    @db.VarChar(50)
  /// master_entity.code. NULL = applies to every legal entity. Warehouse rows
  /// only — a warehouse's point of contact can differ for Pep vs Kreative, while
  /// vendors and manufacturers deal with us as one company. Recipients are the
  /// UNION of the NULL rows and the matching entity's rows; see
  /// prisma/add_entity_email_legal_entity.sql.
  legal_entity_code String?             @db.VarChar(50)
  email       String                    @db.VarChar(255)
  /// Which header this address goes in. Defaults to `to`, which is how every
  /// row behaved before the column existed.
  recipient_type entity_emails_recipient_type @default(to)
  purpose     String?                   @db.VarChar(100)
  /// COALESCE(legal_entity_code, ''), generated. Exists only so uq_entity_email
  /// can treat "every entity" as one comparable value — MySQL counts NULLs as
  /// distinct in a unique index, so indexing the nullable column would allow the
  /// same address twice for the same warehouse. See
  /// prisma/add_entity_email_unique.sql.
  legal_entity_key String?               @db.VarChar(50)
  /// Deactivating stops the mail without destroying the record of who used to
  /// receive it. EVERY send path filters status = 'active' — see
  /// lib/queries/entity-emails.ts. A status nothing filters on would be a lie.
  status      entity_emails_status      @default(active)
  /// users.id of whoever added the row. NULL on the rows that predate the
  /// column. No FK: a user is deactivated, never deleted, so it cannot dangle.
  created_by  Int?
  created_at  DateTime?                 @default(now()) @db.Timestamp(0)

  @@index([entity_type, entity_code, legal_entity_code], map: "idx_entity_emails_lookup")
}

