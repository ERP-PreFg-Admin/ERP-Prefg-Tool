generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model approval_items {
  id          Int       @id @default(autoincrement())
  approval_id Int
  field_name  String?   @db.VarChar(100)
  old_value   String?   @db.Text
  new_value   String?   @db.Text
  approvals   approvals @relation(fields: [approval_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "approval_items_ibfk_1")

  @@index([approval_id], map: "approval_id")
}

model approvals {
  id                                 Int               @id @default(autoincrement())
  raised_by                          Int
  raised_on                          DateTime?         @default(now()) @db.Timestamp(0)
  status                             approvals_status? @default(pending)
  remarks                            String?           @db.Text
  approved_by                        Int?
  approved_on                        DateTime?         @db.Timestamp(0)
  approval_type                      String?           @db.VarChar(100)
  module                             String?           @db.VarChar(50)
  entity_id                          Int?
  approval_items                     approval_items[]
  users_approvals_raised_byTousers   users             @relation("approvals_raised_byTousers", fields: [raised_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "approvals_ibfk_1")
  users_approvals_approved_byTousers users?            @relation("approvals_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "approvals_ibfk_2")

  @@index([approved_by], map: "approved_by")
  @@index([raised_by], map: "raised_by")
}

model bom_misc {
  id             Int              @id @default(autoincrement())
  bom_id         Int
  mfg_id         Int
  type           bom_misc_type
  cost           Decimal?         @db.Decimal(12, 4)
  effective_from DateTime?        @db.Date
  effective_till DateTime?        @db.Date
  last_updated   DateTime?        @default(now()) @db.Timestamp(0)
  status         bom_misc_status? @default(active)
  bom            master_bom       @relation(fields: [bom_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bom_misc_ibfk_1")
  mfgs           master_mfgs      @relation(fields: [mfg_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bom_misc_ibfk_2")

  @@index([bom_id], map: "bom_id")
  @@index([mfg_id], map: "mfg_id")
}

model purchase_orders {
  id             Int                     @id @default(autoincrement())
  po_no          String                  @unique(map: "po_no") @db.VarChar(50)
  mfg_id         Int
  date           DateTime                @db.Date
  sku_code       String?                 @db.VarChar(50)
  bom_id         Int?
  qty            Decimal                 @db.Decimal(12, 3)
  unit_price     Decimal?                @db.Decimal(12, 4)
  total_amount   Decimal?                @db.Decimal(14, 4)
  expected_on    DateTime?               @db.Date
  received_qty   Decimal?                @default(0.000) @db.Decimal(12, 3)
  invoice_no     String?                 @db.VarChar(100)
  /// The Unicommerce PO this row was mirrored into. Shared by every inward PO
  /// off the same invoice — Uniware's model is one PO for all SKUs.
  uniware_po_code String?                @db.VarChar(64)
  destination    String?                 @db.VarChar(100)
  /// Free-text "Reason / Notes" captured when the PO was raised, or set from
  /// the bulk CSV. Mandatory only for impromptu POs (see poCreateSchema).
  remarks        String?                 @db.VarChar(300)
  status         purchase_orders_status? @default(draft)
  attachment_key String?                 @db.Text
  po_type        purchase_orders_type?   @default(impromptu)
  csv_source_key String?                 @db.VarChar(500)
  email_sent_at  DateTime?               @db.DateTime(0)
  reference_po   String?                 @db.VarChar(50)
  mfgs           master_mfgs             @relation(fields: [mfg_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_orders_ibfk_1")
  bom            master_bom?             @relation(fields: [bom_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_orders_ibfk_2")
  history_pos    history_pos[]
  invoice_items  supplier_invoice_items[] @relation("InvoiceItemInwardPo")
  invoice_receipts supplier_invoice_items[] @relation("InvoiceItemReceivedAgainstPo")

  @@index([bom_id], map: "bom_id")
  @@index([mfg_id], map: "mfg_id")
  @@index([reference_po], map: "idx_po_reference_po")
}

/**
 * Audit trail for the PO bulk-CSV create/update flow (see
 * lib/approvals/handlers/purchase-orders.ts's poBulkHandler). One row per
 * changed field for an "update" action; a single summary row (field_name/
 * old_value/new_value all null) for a "create" action — mirrors the
 * approval_items diff-per-field convention used elsewhere in this codebase.
 */
model history_pos {
  id              Int                     @id @default(autoincrement())
  po_id           Int
  po_no           String                  @db.VarChar(50)
  action_type     history_pos_action_type
  field_name      String?                 @db.VarChar(50)
  old_value       String?                 @db.VarChar(255)
  new_value       String?                 @db.VarChar(255)
  s3_key          String?                 @db.VarChar(500)
  changed_by      Int?
  changed_on      DateTime?               @default(now()) @db.DateTime(0)
  purchase_orders purchase_orders         @relation(fields: [po_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "history_pos_ibfk_1")
  users           users?                  @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "history_pos_ibfk_2")

  @@index([po_id], map: "idx_history_pos_po_id")
  @@index([changed_by], map: "history_pos_ibfk_2")
}

/// Supplier invoice header, from the PO Inwarding "Add Invoice" flow.
/// The unique (mfg_id, invoice_no) is what stops the same invoice being
/// submitted twice and double-crediting received_qty.
/// See prisma/add_supplier_invoices.sql.
model supplier_invoices {
  id              Int                      @id @default(autoincrement())
  mfg_id          Int
  invoice_no      String                   @db.VarChar(100)
  invoice_date    DateTime?                @db.Date
  currency        String?                  @db.VarChar(10)
  eway_bill_no    String?                  @db.VarChar(50)
  vehicle_no      String?                  @db.VarChar(50)
  po_ref          String?                  @db.VarChar(100)
  seller_gstin    String?                  @db.VarChar(20)
  buyer_gstin     String?                  @db.VarChar(20)
  bill_to_name    String?                  @db.VarChar(255)
  bill_to_address String?                  @db.Text
  bill_to_state   String?                  @db.VarChar(100)
  ship_to_name    String?                  @db.VarChar(255)
  ship_to_address String?                  @db.Text
  destination     String?                  @db.VarChar(100)
  invoice_total   Decimal?                 @db.Decimal(14, 4)
  attachment_key  String?                  @db.Text
  /// Code Uniware assigned when this invoice was mirrored — its own series, and
  /// the reference quoted to the manufacturer.
  uniware_po_code String?                  @db.VarChar(64)
  /// What Unicommerce last reported for that PO, and when we asked. Refreshed by
  /// the Sync button on the invoices tab / PO Inwarding desk, never on a
  /// schedule — so a NULL timestamp means never asked, not "no status".
  /// See prisma/add_invoice_uniware_status.sql.
  uniware_status    String?                @db.VarChar(40)
  uniware_synced_at DateTime?              @db.DateTime(0)
  created_by      Int?
  created_at      DateTime                 @default(now()) @db.DateTime(0)
  mfgs            master_mfgs              @relation(fields: [mfg_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_supplier_invoices_mfg")
  users           users?                   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_supplier_invoices_user")
  items           supplier_invoice_items[]

  @@unique([mfg_id, invoice_no], map: "uq_supplier_invoice")
  @@index([mfg_id], map: "idx_supplier_invoices_mfg")
  @@index([uniware_po_code], map: "idx_supplier_invoices_uniware_po")
}

/// One row per invoice line. The model is one PO per SKU, so each line resolves
/// to exactly one purchase_orders row — either the inward PO it raised
/// (link_type = created) or the open PO it was received against (= received).
model supplier_invoice_items {
  id                     Int @id @default(autoincrement())
  invoice_id             Int
  line_no                Int
  /// The inward PO this line raised.
  po_id                  Int?
  /// The pre-existing PO it was also received against, if any.
  received_against_po_id Int?
  link_type       supplier_invoice_items_link_type
  sku_code        String?                      @db.VarChar(50)
  parsed_sku_code String?                      @db.VarChar(100)
  sku_name        String?                      @db.VarChar(500)
  batch           String?                      @db.VarChar(100)
  mfg_date        String?                      @db.VarChar(20)
  expiry          String?                      @db.VarChar(20)
  hsn             String?                      @db.VarChar(20)
  qty             Decimal                      @db.Decimal(12, 3)
  rate            Decimal?                     @db.Decimal(12, 4)
  mrp             Decimal?                     @db.Decimal(12, 4)
  discount        Decimal?                     @db.Decimal(12, 4)
  gst_percent     Decimal?                     @db.Decimal(6, 3)
  amount          Decimal?                     @db.Decimal(14, 4)
  total_amount    Decimal?                     @db.Decimal(14, 4)
  invoice         supplier_invoices            @relation(fields: [invoice_id], references: [id], onDelete: Cascade, map: "fk_supplier_invoice_items_invoice")
  purchase_orders purchase_orders?             @relation("InvoiceItemInwardPo", fields: [po_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_supplier_invoice_items_po")
  received_against purchase_orders?            @relation("InvoiceItemReceivedAgainstPo", fields: [received_against_po_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sii_received_against_po")

  @@unique([invoice_id, line_no], map: "uq_invoice_line")
  @@index([po_id], map: "idx_supplier_invoice_items_po")
  @@index([received_against_po_id], map: "idx_sii_received_against")
}

enum supplier_invoice_items_link_type {
  created
  received
}

enum history_pos_action_type {
  create
  update
}

model session_history {
  id         Int                   @id @default(autoincrement())
  session_id String                @db.VarChar(36)
  user_id    Int
  event      session_history_event
  ip_address String?               @db.VarChar(45)
  user_agent String?               @db.Text
  event_at   DateTime?             @default(now()) @db.Timestamp(0)
  remarks    String?               @db.VarChar(200)
  users      users                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "session_history_ibfk_1")

  @@index([user_id], map: "user_id")
}

model sessions {
  id          Int                   @id @default(autoincrement())
  session_id  String                @unique(map: "session_id") @db.VarChar(36)
  user_id     Int
  token       String                @db.Text
  ip_address  String?               @db.VarChar(45)
  user_agent  String?               @db.Text
  device_type sessions_device_type? @default(web)
  created_at  DateTime?             @default(now()) @db.Timestamp(0)
  last_active DateTime?             @default(now()) @db.Timestamp(0)
  expires_at  DateTime              @db.Timestamp(0)
  is_active   Boolean?              @default(true)
  users       users                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sessions_ibfk_1")

  @@index([user_id], map: "user_id")
}

model sku_variants {
  id                                     Int         @id @default(autoincrement())
  parent_sku_id                          Int
  variant_sku_id                         Int
  sku_code                               String?     @db.VarChar(50)
  size                                   String?     @db.VarChar(50)
  created_at                             DateTime?   @default(now()) @db.Timestamp(0)
  skus_sku_variants_parent_sku_idToskus  master_skus @relation("sku_variants_parent_sku_idToskus", fields: [parent_sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sku_variants_ibfk_1")
  skus_sku_variants_variant_sku_idToskus master_skus @relation("sku_variants_variant_sku_idToskus", fields: [variant_sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sku_variants_ibfk_2")

  @@unique([parent_sku_id, variant_sku_id], map: "parent_sku_id")
  @@index([variant_sku_id], map: "variant_sku_id")
}

model user_roles {
  user_id Int
  role    String @db.VarChar(100)

  @@id([user_id, role])
}

model page_permissions {
  id           Int                     @id @default(autoincrement())
  role         String                  @db.VarChar(100)
  page_slug    String                  @db.VarChar(100)
  access_level page_permissions_access @default(none)
  created_at   DateTime?               @default(now()) @db.Timestamp(0)

  @@unique([role, page_slug], map: "role_page_slug")
  @@index([role], map: "role")
}

model user_page_permissions {
  id           Int                     @id @default(autoincrement())
  user_id      Int
  page_slug    String                  @db.VarChar(100)
  access_level page_permissions_access
  created_at   DateTime?               @default(now()) @db.Timestamp(0)

  @@unique([user_id, page_slug], map: "user_id_page_slug")
  @@index([user_id], map: "user_id")
}

/// Per-user data scoping — which manufacturers/vendors/warehouses a user may
/// see. NO rows for a (user, entity_type) pair means unrestricted. See
/// prisma/add_user_entity_scope.sql for the full semantics.
model user_entity_scope {
  user_id     Int
  entity_type user_entity_scope_type
  entity_id   Int
  created_at  DateTime @default(now()) @db.DateTime(0)
  created_by  Int?

  @@id([user_id, entity_type, entity_id])
  @@index([user_id], map: "idx_scope_user")
}

enum user_entity_scope_type {
  mfg
  vendor
  warehouse
  brand
}

/// Per-request activity trail, written by lib/gateway/with-gateway.ts for every
/// non-GET API request. No relation to `users` on purpose — see
/// prisma/add_activity_log.sql.
model activity_log {
  id          BigInt   @id @default(autoincrement())
  user_id     Int?
  method      String   @db.VarChar(10)
  path        String   @db.VarChar(255)
  status      Int      @db.SmallInt
  duration_ms Int
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.VarChar(255)
  request_id  String?  @db.Char(36)
  created_on  DateTime @db.DateTime(0)

  @@index([user_id, id], map: "idx_activity_user")
  @@index([created_on], map: "idx_activity_created")
}

model users {
  id                                     Int                       @id @default(autoincrement())
  name                                   String                    @db.VarChar(100)
  email                                  String                    @unique(map: "email") @db.VarChar(100)
  status                                 users_status?             @default(active)
  created_at                             DateTime?                 @default(now()) @db.Timestamp(0)
  google_id                              String?                   @db.VarChar(255)
  approvals_approvals_raised_byTousers   approvals[]               @relation("approvals_raised_byTousers")
  approvals_approvals_approved_byTousers approvals[]               @relation("approvals_approved_byTousers")
  bom_artifacts                          bom_artifacts[]
  master_bom                             master_bom[]
  master_bom_mfg                         master_bom_mfg[]
  master_cost_ext_fixed                  master_cost_ext_fixed[]
  master_cost_int_dynamic                master_cost_int_dynamic[]
  master_skus                            master_skus[]
  master_vendors                         master_vendors[]
  session_history                        session_history[]
  sessions                               sessions[]
  history_pos                            history_pos[]
  supplier_invoices                      supplier_invoices[]
}

model details_bom {
  id                        Int                         @id @default(autoincrement())
  bom_id                    Int
  mtrl_type                 details_bom_mtrl_type
  mtrl_id                   Int
  amount                    Decimal                     @db.Decimal(12, 4)
  uom                       String?                     @db.VarChar(20)
  last_updated              DateTime?                   @default(now()) @db.Timestamp(0)
  status                    details_bom_status?         @default(active)
  updated_by                Int?
  master_bom                master_bom                  @relation(fields: [bom_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "details_bom_ibfk_1")
  details_cost__int_dynamic details_cost__int_dynamic[]
  details_cost_ext_fixed    details_cost_ext_fixed[]

  @@index([bom_id], map: "bom_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model details_cost__int_dynamic {
  id                      Int                                 @id @default(autoincrement())
  cost_id                 Int
  bom_detail_id           Int
  mtrl_type               details_cost__int_dynamic_mtrl_type
  mtrl_id                 Int
  qty                     Decimal                             @db.Decimal(10, 3)
  uom                     String                              @db.VarChar(20)
  rate                    Decimal                             @db.Decimal(12, 4)
  rm_vrm_id               Int
  pm_vrm_id               Int
  line_cost               Decimal?                            @db.Decimal(12, 4)
  details_bom             details_bom                         @relation(fields: [bom_detail_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dci_bomdet")
  master_cost_int_dynamic master_cost_int_dynamic             @relation(fields: [cost_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dci_cost")
  rm_vrm_dynamic          rm_vrm_dynamic                      @relation(fields: [rm_vrm_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dci_rmvrm")

  @@index([bom_detail_id], map: "fk_dci_bomdet")
  @@index([cost_id], map: "fk_dci_cost")
  @@index([rm_vrm_id], map: "fk_dci_rmvrm")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model details_cost_ext_fixed {
  id                    Int                              @id @default(autoincrement())
  cost_id               Int
  bom_detail_id         Int
  mtrl_type             details_cost_ext_fixed_mtrl_type
  mtrl_id               Int
  qty                   Decimal                          @db.Decimal(10, 3)
  uom                   String                           @db.VarChar(20)
  rate                  Decimal                          @db.Decimal(12, 4)
  rm_mrm_id             Int?
  pm_mrm_id             Int?
  line_cost             Decimal?                         @db.Decimal(12, 4)
  details_bom           details_bom                      @relation(fields: [bom_detail_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dce_bomdet")
  master_cost_ext_fixed master_cost_ext_fixed            @relation(fields: [cost_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dce_cost")
  rm_mrm_fixed          rm_mrm_fixed?                    @relation(fields: [rm_mrm_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dci_rmmrm")

  @@index([bom_detail_id], map: "fk_dce_bomdet")
  @@index([cost_id], map: "fk_dce_cost")
  @@index([rm_mrm_id], map: "fk_dci_rmmrm")
}

model details_mfg {
