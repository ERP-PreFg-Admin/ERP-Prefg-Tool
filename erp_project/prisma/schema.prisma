  vendor_code    String?               @db.VarChar(50)
  curr_rate      Decimal               @db.Decimal(12, 4)
  effective_from DateTime              @db.Date
  effective_to   DateTime?             @db.Date
  updated_on     DateTime?             @default(now()) @db.Timestamp(0)
  moq            Decimal?              @db.Decimal(12, 3)
  uom            String?               @db.VarChar(20)
  status         pm_vrm_dynamic_status @default(draft)
  master_pm      master_pm             @relation(fields: [pm_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pm_vrm_dynamic_ibfk_1")
  master_vendors master_vendors        @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pm_vrm_dynamic_ibfk_2")

  @@index([pm_id], map: "pm_id")
  @@index([vendor_id], map: "vendor_id")
  @@index([status, effective_from], map: "idx_pm_vrm_status_eff")
  @@index([status, curr_rate], map: "idx_pm_vrm_status_rate")
}

