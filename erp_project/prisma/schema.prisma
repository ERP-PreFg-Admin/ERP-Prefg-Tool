  master_entity master_entity? @relation(fields: [entity_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_brand_entity")
  master_skus   master_skus[]

  @@index([entity_id], map: "fk_brand_entity")
}

